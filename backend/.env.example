# ======================================================================
# Divyang Matrimony Backend — Environment Configuration Template
# ======================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# See Architecture Section 3.2 for the full configuration strategy.
# ======================================================================

# --- Environment ---
ENVIRONMENT=development                # development | staging | production
LOG_LEVEL=INFO
PLATFORM_ID=divyang_matrimony

# --- Database ---
DATABASE_URL=postgresql+asyncpg://divyang:devpassword@localhost:5432/divyang_matrimony

# --- Redis (cache + rate-limit only in v1) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (REQUIRED — no defaults, app fails without these) ---
JWT_SECRET_KEY=                        # Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15     # Short-lived access tokens (stateless)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30       # Long-lived refresh tokens (stateful via active_sessions)

# --- OTP ---
OTP_EXPIRE_SECONDS=300                 # 5 minutes
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3                     # Wrong guesses before OTP is invalidated
OTP_RATE_LIMIT_PER_HOUR=5             # Max send requests per phone per hour

# --- Auth rate limits (Architecture §7.7) ---
AUTH_MAX_FAILED_ATTEMPTS=5            # Failed logins before account lockout
AUTH_LOCKOUT_SECONDS=900              # 15-minute lockout
AUTH_LOCKOUT_WINDOW_SECONDS=900       # Sliding window for counting failures

# --- Field-level encryption (REQUIRED — used for sensitive profile data) ---
FIELD_ENCRYPTION_KEY=                  # Generate: python -c "import os; print(os.urandom(32).hex())"

# --- Firebase (REQUIRED) ---
FIREBASE_CREDENTIALS_PATH=             # Absolute path to service account JSON file
FIREBASE_STORAGE_BUCKET=               # e.g., divyang-matrimony-dev.appspot.com

# --- Razorpay (REQUIRED — sandbox keys for v1) ---
RAZORPAY_KEY_ID=                       # rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Sentry (optional in dev) ---
SENTRY_DSN=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
